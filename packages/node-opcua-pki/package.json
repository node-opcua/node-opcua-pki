{
    "name": "node-opcua-pki",
    "version": "6.22.0",
    "description": "PKI management for node-opcua",
    "type": "module",
    "main": "./dist/lib/index.js",
    "types": "./dist/lib/index.d.ts",
    "exports": {
        ".": "./dist/lib/index.js",
        "./core": "./dist/lib/core.js",
        "./package.json": "./package.json"
    },
    "bin": {
        "pki": "./dist/bin/pki.js",
        "node-opcua-pki": "./dist/bin/pki.js"
    },
    "files": [
        "dist",
        "bin",
        "LICENSE",
        "readme.md"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/node-opcua/node-opcua-pki.git"
    },
    "bugs": {
        "url": "https://github.com/node-opcua/node-opcua-pki/issues"
    },
    "keywords": [
        "PKI",
        "node-opcua"
    ],
    "collective": {
        "url": "https://opencollective.com/node-opcua"
    },
    "author": "Etienne Rossignon",
    "license": "MIT",
    "sideEffects": false,
    "dependencies": {
        "@ster5/global-mutex": "^3.3.0",
        "byline": "^5.0.0",
        "chalk": "4.1.2",
        "chokidar": "4.0.3",
        "command-line-args": "^6.0.2",
        "command-line-usage": "^7.0.4",
        "node-opcua-crypto": "6.0.0",
        "yauzl": "^3.4.0"
    },
    "//scheme": "ESM-only, unbundled tsc build matching the node-opcua monorepo scheme (dist mirrors lib/ + bin/, no CJS). String export targets carry no 'require' condition, so require('node-opcua-pki') resolves here on Node 22.12+ (require of an ES module; the graph has no top-level await) and fails with ERR_REQUIRE_ESM on older Node."
}
